PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
# For deployments with a separate internal web origin or Chromium executable, set DECK_RENDER_ORIGIN and DECK_RENDER_CHROMIUM.

# Server-side only. Set the key and an ordered JSON array of model configurations.
OPENAI_API_KEY=
OPENAI_TEXT_MODELS='[{"provider":"openai","model":"gpt-5.4-mini","max_output_tokens":4096,"tool_providers":["session"]}]'
# Example OPENAI_TEXT_MODELS entry array (replace the model ID)
# OPENAI_TEXT_MODELS='[{"provider":"openai","model":"<your-model-id>","max_output_tokens":2048,"tool_providers":["session"]}]'

# Private credential shared by the Express API and Python interview worker.
VOICE_WORKER_TOKEN=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_LIVE_MODEL=gpt-live-1.1
OPENAI_SPEECH_VOICE=marin
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
